# PostgreSQL Database Configuration
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=bitfinex_lending
POSTGRES_PORT=5432

# Database URL for backend application
DATABASE_URL=postgresql://user:password@localhost:5432/bitfinex_lending

# pgAdmin Configuration (optional)
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# JWT Configuration
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# API Key Encryption (must be 32 bytes base64)
ENCRYPTION_KEY=your-32-byte-base64-encryption-key

# Bitfinex API Configuration
BITFINEX_API_URL=https://api.bitfinex.com/v2
BITFINEX_API_VERSION=v2

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Application Configuration
PROJECT_NAME=Bitfinex Lending Bot
API_V1_STR=/api/v1


